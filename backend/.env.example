# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME="LifeSearch AI Service"
ENVIRONMENT=local
DEBUG=true

# Supabase project (Settings -> API). SUPABASE_ANON_KEY is the same
# publishable/anon key the Flutter app uses (mobile/.env) — safe to share,
# used only as the `apikey` header on requests scoped by a user's own
# session token. See core/security.py.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only needed once something requires bypassing RLS (none of Phase 4
# does). Leave empty until that's actually true.
SUPABASE_SERVICE_ROLE_KEY=

# Not used yet — Phase 5's vector similarity search will need a direct
# Postgres connection (PostgREST can't do `ORDER BY embedding <=> ...`).
DATABASE_URL=postgresql+asyncpg://lifesearch:lifesearch@localhost:5432/lifesearch

# AI provider selection: openai | gemini | local
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

ALLOWED_ORIGINS=["*"]

# Per-user requests/minute on the endpoints that call an AI provider
# (/ai/process-item, /ai/ask, /search/). Defaults are generous for one
# person's real usage but cap the damage from a client bug or a leaked
# token. See core/rate_limit.py.
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=30
