# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME="LifeSearch AI Service"
ENVIRONMENT=local
DEBUG=true

# Supabase project (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Supabase Settings -> Database, or local docker-compose db)
DATABASE_URL=postgresql+asyncpg://lifesearch:lifesearch@localhost:5432/lifesearch

# AI provider selection: openai | gemini | local
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Used to verify Supabase-issued JWTs (Settings -> API -> JWT Secret)
JWT_SECRET=

ALLOWED_ORIGINS=["*"]
