# Copy to .env and fill in from your Supabase project:
# Project Settings -> API -> Project URL / anon public key.
# These are safe to embed in the app (RLS enforces access control) —
# never put the service_role key here, that stays backend-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LifeSearch AI Service (backend/), for local dev. 127.0.0.1 works from
# the iOS Simulator — Android emulator needs 10.0.2.2, a physical device
# needs the Mac's LAN IP. Leave empty to run with AI processing disabled.
BACKEND_URL=http://127.0.0.1:8000

# Google/Apple login (Faz 11, madde 5 — see docs/roadmap.md). Both need
# real setup in Google Cloud Console / Apple Developer / Supabase
# Dashboard first — see docs/google-apple-login-setup.md for the full
# checklist. Leave both Google values empty to hide that button
# entirely; Apple needs no .env value at all (Xcode capability only).
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
